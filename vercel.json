{
  "version": 2,
  "builds": [
    {
      "src": "server/index.js",
      "use": "@vercel/node"
    },
    {
      "src": "index.html",
      "use": "@vercel/static"
    }
  ],
  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/server/index.js"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ],
  "env": {
    "CLERK_PUBLISHABLE_KEY": "YOUR_CLERK_PUBLISHABLE_KEY",
    "CLERK_SECRET_KEY": "YOUR_CLERK_SECRET_KEY",
    "JWT_SECRET": "YOUR_JWT_SECRET",
    "PORT": "3000",
    "FRONTEND_URL": "YOUR_FRONTEND_URL",
    "DB_PATH": "./hunar.db"
  }
}